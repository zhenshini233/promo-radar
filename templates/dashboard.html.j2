<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>promo-radar · 免费云资源雷达</title>
<link rel="stylesheet" href="styles.css">
<script>
(function () {
  try {
    var t = localStorage.getItem("radar-theme");
    if (t) document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
</head>
<body>

{% if freshness and freshness.level != 'ok' %}
<div class="stale-banner {{ freshness.level }}" role="status">
  <span>{{ freshness.message }}</span>
  {% if freshness.last_success_at %}
  <span class="t2">最近成功：{{ freshness.last_success_at[:16].replace('T', ' ') }} UTC</span>
  {% endif %}
</div>
{% endif %}

<noscript>
  <div class="noscript">
    <h1>promo-radar</h1>
    <p>这是一个交互式资源目录，需要启用 JavaScript。</p>
    <p>共 {{ kpis.total_offers }} 条资源（AI {{ kpis.total_deals }} · 云 {{ kpis.cloud_offers }}），
       监控 {{ kpis.monitors }} 个厂商页面。</p>
    <p>更新于 {{ generated_at[:16].replace('T', ' ') }} UTC ·
       <a href="atom.xml">Atom 订阅</a> ·
       <a href="data.json">data.json</a></p>
  </div>
</noscript>

<div id="app"></div>

<script type="text/x-template" id="tpl-app">
<div class="shell">
  <header class="topbar">
    <a class="brand" href="#/deals" @click.prevent="goTo('deals')">
      <span class="mark">PR</span><span>promo-radar</span>
    </a>
    <nav class="topnav" aria-label="页面">
      <a href="#/deals" :class="{active: st.page==='deals'}" @click.prevent="goTo('deals')">资源</a>
      <a href="#/monitors" :class="{active: st.page==='monitors'}" @click.prevent="goTo('monitors')">厂商</a>
      <a href="#/overview" :class="{active: st.page==='overview'}" @click.prevent="goTo('overview')">总览</a>
      <a href="#/archive" :class="{active: st.page==='archive'}" @click.prevent="goTo('archive')">已过期</a>
      <a href="#/sources" :class="{active: st.page==='sources'}" @click.prevent="goTo('sources')">数据源</a>
    </nav>
    <div class="top-actions">
      <span class="sub num">[[ generated_at.slice(0,16).replace('T',' ') ]] UTC</span>
      <a href="atom.xml" target="_blank" rel="noopener" title="Atom 订阅：复制此链接到 RSS 阅读器">订阅</a>
      <button v-if="st.serveMode" class="btn small" @click="st.showLocal = !st.showLocal">本地操作</button>
      <button class="icon-btn" @click="toggleTheme" title="切换主题">◐</button>
    </div>
  </header>

  <div class="local-panel" v-if="st.serveMode && st.showLocal">
    <div class="local-head">
      <b>本地操作</b>
      <button class="icon-btn" @click="st.showLocal = false" title="关闭">×</button>
    </div>
    <div class="local-block">
      <b>手动刷新</b>
      <details>
        <summary>选择部分源（不选 = 全部）</summary>
        <label v-for="s in srcRows" :key="s.id" class="check">
          <input type="checkbox" v-model="st.refreshSel[s.id]"> [[ s.name ]]
        </label>
      </details>
      <button class="btn primary" :disabled="st.refreshing" @click="startRefresh">
        [[ st.refreshing ? '刷新中…' : '开始刷新' ]]
      </button>
      <p class="t2">[[ st.refreshMsg ]]</p>
    </div>
    <div class="local-block">
      <b>代理</b>
      <input class="input" v-model="st.proxyUrl" placeholder="http://127.0.0.1:10808">
      <button class="btn" :disabled="st.proxySaving" @click="saveProxy">
        [[ st.proxySaving ? '保存中…' : '保存并测试' ]]
      </button>
      <p class="t2">[[ st.proxyMsg ]]</p>
    </div>
  </div>
  <main class="page">
    {# ---------- 资源 ---------- #}
    <section v-if="st.page==='deals'">
      <div class="page-head">
        <div>
          <h1>全部资源</h1>
          <p class="sub">AI 促销与免费云资源，同一份目录、同一套筛选。</p>
        </div>
        <div class="tabs" role="tablist" aria-label="视图">
          <button class="tab" :class="{on: st.dealView==='table'}" @click="st.dealView='table'">表格</button>
          <button class="tab" :class="{on: st.dealView==='cards'}" @click="st.dealView='cards'">卡片</button>
          <button class="tab" :class="{on: st.dealView==='timeline'}" @click="st.dealView='timeline'">时间线</button>
        </div>
      </div>

      <div class="kpi-strip">
        <div class="kpi"><span class="k">资源</span><b class="num">[[ deals.length ]]</b></div>
        <div class="kpi"><span class="k">可用</span><b class="num">[[ deals.filter(function(d){return d.status==='active'}).length ]]</b></div>
        <div class="kpi"><span class="k">AI 促销</span><b class="num">[[ deals.filter(function(d){return d.vertical==='ai_api'}).length ]]</b></div>
        <div class="kpi"><span class="k">云资源</span><b class="num">[[ deals.filter(function(d){return d.vertical!=='ai_api'}).length ]]</b></div>
        <div class="kpi"><span class="k">本周新增</span><b class="num">[[ kpis.new_this_week ]]</b></div>
      </div>

      <div class="usecase-strip">
        <span class="label">用途</span>
        <button class="chip" :class="{on: st.useCase==='all'}" @click="st.useCase='all'">全部</button>
        <button v-for="u in useCases" :key="u.id" class="chip"
                :class="{on: st.useCase===u.id}" @click="st.useCase=u.id">[[ u.label ]]</button>
      </div>

      <div class="filters">
        <div class="search-row">
          <input class="search" v-model="st.q" type="search" placeholder="搜索资源 / 厂商 / 规格…" aria-label="搜索">
          <select class="picker" v-model="st.sort" aria-label="排序">
            <option value="recent">最新发现</option>
            <option value="score">按匹配分</option>
            <option value="amount">按额度</option>
          </select>
          <button class="chip ghost" v-if="anyFilter" @click="clearFilters">清除筛选</button>
          <span class="result-count num">[[ filteredDeals.length ]] 条</span>
        </div>
        <div class="chip-groups">
          <div v-for="grp in chipGroups" :key="grp.label" class="chip-line">
            <span class="label">[[ grp.label ]]</span>
            <template v-for="c in grp.chips" :key="c.g + c.k">
              <span v-if="c.g === 'label'" class="label sub-label">[[ c.label ]]</span>
              <button v-else class="chip" :class="{on: c.on}" @click="toggle(c.g, c.k)">
                [[ c.label ]] <span class="count num">[[ c.count ]]</span>
              </button>
            </template>
          </div>
        </div>
      </div>

      <div v-if="st.dealView==='table'" class="table-wrap">
        <table>
          <thead><tr>
            <th class="col-title">资源</th><th>厂商</th><th>领域</th><th>类型</th>
            <th class="num">规格 / 额度</th><th>门槛</th><th class="num">证据</th><th>状态</th><th>领取</th>
          </tr></thead>
          <tbody>
            <tr v-for="d in pagedDeals" :key="d.dedup_key">
              <td class="col-title">
                <a :href="d.url" target="_blank" rel="noopener noreferrer">[[ d.title ]]</a>
                <div class="t2" v-if="d.evidence">[[ d.evidence.slice(0, 110) ]]</div>
                <div class="t2" v-if="d.claim_steps">领取：[[ d.claim_steps ]]</div>
              </td>
              <td>[[ d.provider || '—' ]]</td>
              <td><span class="pill src">[[ d.vertical_cn || d.vertical ]]</span></td>
              <td><span class="pill hit">[[ d.type_cn || d.offer_type ]]</span></td>
              <td class="num">[[ d.res_text || firstAmount(d) || '—' ]]</td>
              <td>[[ d.card_text || (d.card_required_hint === false ? '免绑卡' : d.card_required_hint === true ? '需绑卡' : '—') ]]</td>
              <td class="num">[[ d.evidence_count || 1 ]]</td>
              <td><span class="pill" :class="d.status_cls || d.status">[[ STATUS_NAMES[d.status] ]]</span></td>
              <td><button class="btn small" @click="toggleClaim(d)">[[ claimLabel(d) ]]</button></td>
            </tr>
            <tr v-if="!pagedDeals.length"><td colspan="9" class="empty-cell">没有符合条件的资源</td></tr>
          </tbody>
        </table>
      </div>

      <div v-if="st.dealView==='cards'" class="cards">
        <article v-for="d in pagedDeals" :key="d.dedup_key" class="card">
          <div class="card-head">
            <span class="pill" :class="d.status_cls || d.status">[[ STATUS_NAMES[d.status] ]]</span>
            <span class="pill src">[[ d.vertical_cn || d.vertical ]]</span>
            <span class="pill hit">[[ d.type_cn || d.offer_type ]]</span>
            <span class="amount num" v-if="d.res_text">[[ d.res_text ]]</span>
          </div>
          <div class="card-title"><a :href="d.url" target="_blank" rel="noopener noreferrer">[[ d.title ]]</a></div>
          <div class="card-ev" v-if="d.evidence">[[ d.evidence ]]</div>
          <div class="card-ev claim" v-if="d.claim_steps">领取：[[ d.claim_steps ]]</div>
          <div class="card-meta">
            <span v-if="d.provider" class="provider">[[ d.provider ]]</span>
            <span class="t2">[[ d.card_text || '门槛未标注' ]]</span>
            <span class="t2 num">[[ d.evidence_count || 1 ]] 条证据</span>
            <button class="btn small" @click="toggleClaim(d)">[[ claimLabel(d) ]]</button>
          </div>
        </article>
        <div class="empty" v-if="!pagedDeals.length">没有符合条件的资源</div>
      </div>

      <div v-if="st.dealView==='timeline'" class="timeline">
        <div class="tl-day" v-for="day in timelineDays" :key="day.day">
          <div class="tl-head"><span>[[ day.day ]]</span><span class="t2 num">[[ day.rows.length ]] 条</span></div>
          <div class="tl-item" v-for="d in day.rows" :key="d.dedup_key">
            <span class="t2 num">[[ d.first_seen_at.slice(11,16) ]]</span>
            <a :href="d.url" target="_blank" rel="noopener noreferrer">[[ d.title ]]</a>
            <span class="t2">[[ d.vertical_cn ]]</span>
            <span class="pill" :class="d.status_cls || d.status">[[ STATUS_NAMES[d.status] ]]</span>
          </div>
        </div>
        <div class="empty" v-if="!timelineDays.length">没有符合条件的资源</div>
      </div>

      <div class="pager" v-if="st.dealView !== 'timeline' && dealPages > 1">
        <button class="btn small" :disabled="st.pageNum<=1" @click="dealPageGo(st.pageNum-1)">上一页</button>
        <template v-for="(p, i) in pageList" :key="i">
          <span v-if="p === '…'" class="t2">…</span>
          <button v-else class="btn small" :class="{on: p === st.pageNum}" @click="dealPageGo(p)">[[ p ]]</button>
        </template>
        <button class="btn small" :disabled="st.pageNum>=dealPages" @click="dealPageGo(st.pageNum+1)">下一页</button>
        <select class="picker" v-model.number="st.pageSize">
          <option :value="24">24 / 页</option><option :value="48">48 / 页</option><option :value="96">96 / 页</option>
        </select>
      </div>

      <div class="claim-bar">
        <span class="t2">领取状态只存本机浏览器，可导出/导入。</span>
        <button class="btn small" @click="exportClaims">导出领取记录</button>
        <label class="btn small">导入<input type="file" accept="application/json" hidden @change="importClaims"></label>
        <span class="t2">[[ st.claimMsg ]]</span>
      </div>
    </section>

    {# ---------- 厂商 ---------- #}
    <section v-if="st.page==='monitors'">
      <div class="page-head">
        <div><h1>厂商</h1><p class="sub">AI 与云的统一厂商视图，按资源数排序。</p></div>
      </div>
      <div class="filters">
        <div class="search-row">
          <input class="search" v-model="st.monQ" type="search" placeholder="搜索厂商 / 品类…" aria-label="搜索厂商">
          <div class="tabs">
            <button class="tab" :class="{on: st.monFilter==='all'}" @click="st.monFilter='all'; st.monPage=1">全部</button>
            <button class="tab" :class="{on: st.monFilter==='monitored'}" @click="st.monFilter='monitored'; st.monPage=1">有官网监控</button>
            <button class="tab" :class="{on: st.monFilter==='catalog'}" @click="st.monFilter='catalog'; st.monPage=1">仅目录 / 官方页</button>
          </div>
          <span class="result-count num">[[ filteredVendors.length ]] 家</span>
        </div>
        <div class="chip-line">
          <span class="label">领域</span>
          <button class="chip" :class="{on: st.monV==='all'}" @click="st.monV='all'; st.monPage=1">
            全部 <span class="count num">[[ vendors.length ]]</span>
          </button>
          <button v-for="v in vendorVerticals" :key="v.id" class="chip"
                  :class="{on: st.monV===v.id}" @click="st.monV=v.id; st.monPage=1">
            [[ v.label ]] <span class="count num">[[ v.count ]]</span>
          </button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th class="col-title">厂商</th><th>领域</th><th class="num">可用 / 资源</th>
            <th>品类</th><th class="num">最近更新</th><th>官网监控</th>
          </tr></thead>
          <tbody>
            <tr v-for="v in pagedVendors" :key="v.name">
              <td class="col-title">[[ v.name ]]</td>
              <td><span class="pill src">[[ verticalName(v.vertical) ]]</span></td>
              <td class="num">[[ v.active ]] / [[ v.offers ]]</td>
              <td class="t2">[[ (v.categories || []).slice(0,3).join(' · ') ]]</td>
              <td class="num">[[ (v.last_seen || '').slice(0,10) ]]</td>
              <td><span v-if="v.monitored" class="pill hit">[[ v.pages ]] 页</span><span v-else class="t2">目录 / 官方页</span></td>
            </tr>
            <tr v-if="!pagedVendors.length"><td colspan="6" class="empty-cell">没有符合条件的厂商</td></tr>
          </tbody>
        </table>
      </div>
      <div class="pager" v-if="vendorPages > 1">
        <button class="btn small" :disabled="st.monPage<=1" @click="st.monPage--">上一页</button>
        <span class="t2 num">[[ st.monPage ]] / [[ vendorPages ]]</span>
        <button class="btn small" :disabled="st.monPage>=vendorPages" @click="st.monPage++">下一页</button>
      </div>
    </section>

    {# ---------- 总览 ---------- #}
    <section v-if="st.page==='overview'">
      <div class="page-head">
        <div><h1>总览</h1><p class="sub">[[ digest.today ]] · 上次成功 [[ (digest.last_success || '').slice(0,16).replace('T',' ') || '—' ]]</p></div>
      </div>
      <div class="kpi-strip">
        <div class="kpi"><span class="k">今日新增</span><b class="num">[[ digest.today_new ]]</b></div>
        <div class="kpi"><span class="k">最近可用</span><b class="num">[[ digest.recent_active ]]</b></div>
        <div class="kpi"><span class="k">未抓取厂商</span><b class="num">[[ digest.missed_count ]]</b></div>
        <div class="kpi"><span class="k">反馈</span><b class="num">[[ feedbackStats.total ]]</b></div>
      </div>
      <div class="split">
        <div class="panel">
          <h2>今天新增</h2>
          <div class="list-box">
            <div v-for="d in todayNew" :key="d.dedup_key" class="row">
              <span class="amount num">[[ d.res_text || firstAmount(d) || '—' ]]</span>
              <a :href="d.url" target="_blank" rel="noopener noreferrer">[[ d.title ]]</a>
              <span class="pill" :class="d.status_cls || d.status">[[ STATUS_NAMES[d.status] ]]</span>
            </div>
            <div v-if="!todayNew.length" class="empty">今天还没有新增。</div>
          </div>
        </div>
        <div class="panel">
          <h2>反馈分布</h2>
          <div class="list-box">
            <div class="row"><span>👍 有价值</span><b class="num">[[ feedbackStats.up ]]</b></div>
            <div class="row"><span>👎 误报</span><b class="num">[[ feedbackStats.down ]]</b></div>
            <div class="row"><span>💤 暂不关心</span><b class="num">[[ feedbackStats.snooze ]]</b></div>
          </div>
        </div>
      </div>
    </section>

    {# ---------- 已过期 ---------- #}
    <section v-if="st.page==='archive'">
      <div class="page-head">
        <div><h1>已过期</h1><p class="sub">只归档不删除，保留历史证据。</p></div>
        <span class="result-count num">[[ expiredDeals.length ]] 条</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th class="col-title">资源</th><th>厂商</th><th>领域</th><th>原因</th><th class="num">最后更新</th></tr></thead>
          <tbody>
            <tr v-for="d in expiredDeals" :key="d.dedup_key">
              <td class="col-title"><a :href="d.url" target="_blank" rel="noopener noreferrer">[[ d.title ]]</a></td>
              <td>[[ d.provider || '—' ]]</td>
              <td><span class="pill src">[[ d.vertical_cn ]]</span></td>
              <td class="t2">[[ d.status_reason === 'stale' ? '长期未再见' : d.status_reason === 'expires_at' ? '已到截止时间' : d.status_reason === 'upstream_removed' ? '上游已移除' : '—' ]]</td>
              <td class="num">[[ (d.last_seen_at || '').slice(0,10) ]]</td>
            </tr>
            <tr v-if="!expiredDeals.length"><td colspan="5" class="empty-cell">暂无已过期资源</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    {# ---------- 数据源 ---------- #}
    <section v-if="st.page==='sources'">
      <div class="page-head">
        <div><h1>数据源</h1><p class="sub">每个源的最近一次运行状态与产出。</p></div>
        <span class="result-count num">[[ srcSummary ]]</span>
      </div>
      <div class="source-grid">
        <div class="source-card" v-for="s in sourceCards" :key="s.id">
          <div class="source-head">
            <b>[[ s.name ]]</b>
            <span class="pill" :class="s.ok === false ? 'card-yes' : 'card-no'">[[ s.ok === false ? '失败' : '正常' ]]</span>
          </div>
          <p class="t2">[[ s.blurb ]]</p>
          <div class="source-stats">
            <span><b class="num">[[ s.dealsCount ]]</b> 资源</span>
            <span><b class="num">[[ s.vendorCount || 0 ]]</b> 厂商</span>
          </div>
          <div class="t2" v-if="s.error">[[ s.error ]]</div>
          <a href="#" class="link" @click.prevent="goSource(s.id)">查看该源资源 →</a>
        </div>
      </div>
    </section>
  </main>
</div>
</script>

<script type="application/json" id="radar-data">{{ payload_json | safe }}</script>
<script src="data.js"></script>
<script src="vendor/vue.global.prod.js"></script>
<script src="app.js"></script>
</body>
</html>